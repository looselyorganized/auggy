  page.setDefaultTimeout(15000);
  page.on("request", request => {
    if (new URL(request.url()).origin !== config.agentOrigin || new URL(request.url()).pathname !== "/agent/run" || request.method() !== "POST") return;
    pending.push((async () => {
      const headers = await request.allHeaders();
      observations.directAgentRequests++;
      observations.applicationCookiesSentToAgent ||= Boolean(headers.cookie);
      observations.creatorCredentialSentToAgent ||= Boolean(headers.authorization);
      check(typeof headers["x-auggy-auth-assertion"] === "string", "Direct request has no assertion");
