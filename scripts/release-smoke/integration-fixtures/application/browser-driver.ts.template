  await page.locator("#support-message").waitFor({ state: "visible" });
  await page.waitForFunction(() => !document.querySelector("#support-message")?.disabled);
  return page;
}
async function send(page, text) {
  await page.locator("#support-message").fill(text);
  await page.getByRole("button", { name: "Send message", exact: true }).click();
}
async function measureLayout(page) {
  return await page.evaluate(async () => {
    await document.fonts.ready;
    await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    const rect = selector => {
      const element = document.querySelector(selector);
      if (!element) throw new Error("Required layout region missing");
      const { left, right, width } = element.getBoundingClientRect();
      return { left, right, width };
    };
    return { innerWidth: window.innerWidth, clientWidth: document.documentElement.clientWidth, scrollWidth: document.documentElement.scrollWidth, app: rect(".app-shell"), conversation: rect(".conversation") };
  });
}
async function captureLayout(page, size) {
