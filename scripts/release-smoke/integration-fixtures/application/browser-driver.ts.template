}
try {
  phase = "customer-read";
  await control("/configure", { scenario: "read-a" });
  const customer = await pageFor(config.sessions.customerA);
  await customer.locator("#support-message").focus();
  observations.keyboardFocusVisible = await customer.locator("#support-message").evaluate(el => el === document.activeElement && (getComputedStyle(el).boxShadow !== "none" || getComputedStyle(el).outlineStyle !== "none"));
  await captureLayout(customer, "desktop");
  await send(customer, "Read my order order-a");
  await customer.locator('[data-testid="agent-response"][data-state="streaming"] .response-text').waitFor({ state: "visible" });
  check((await customer.locator('[data-testid="agent-response"]').last().innerText()).includes(config.expectedMarker), "Browser never received actual model text");
  observations.firstChunkBeforeTerminal = (await customer.locator('[data-testid="agent-response"]').last().getAttribute("data-state")) === "streaming";
  await customer.locator('[data-testid="agent-response"][data-state="completed"]').waitFor();
  observations.checks.push("actual-browser-saw-content-before-terminal", "customer-assertion-direct-agent-flow");
  await customer.setViewportSize({ width: 390, height: 844 });
  await captureLayout(customer, "mobile");
  observations.checks.push("settled-client-width-and-gutters-before-and-after-viewport-capture");

  phase = "support-interruption-retry";
  await control("/configure", { scenario: "refund" });
  const support = await pageFor(config.sessions.support);
  await send(support, "Simulate a 1250 cent refund for order-a");
  await support.locator('[data-testid="agent-response"][data-state="streaming"] .response-text').waitFor();
  const originalKey = await support.locator("article[data-operation-key]").last().getAttribute("data-operation-key");
  await support.getByRole("button", { name: "Stop receiving", exact: true }).click();
  await support.locator('[data-testid="agent-response"][data-state="interrupted"]').waitFor();
  await control("/settled", {});
  await support.getByRole("button", { name: "Retry delivery", exact: true }).click();
  await support.locator('[data-testid="agent-response"][data-state="completed"]').waitFor();
  const repeatedKey = await support.locator("article[data-operation-key]").last().getAttribute("data-operation-key");
  await Promise.all(pending);
  observations.stableRetryKey = Boolean(originalKey && originalKey === repeatedKey && keys.at(-1) === keys.at(-2));
  observations.interruptedThenCompleted = true;
  observations.freshAssertionCount = assertions.size;
  observations.checks.push("browser-disconnect-does-not-cancel-keyed-operation", "retry-uses-fresh-assertion-and-original-operation-key", "browser-omits-app-session-and-creator-credentials");
  check(observations.firstChunkBeforeTerminal && observations.stableRetryKey && observations.freshAssertionCount === observations.directAgentRequests && observations.directAgentRequests === 3 && !observations.applicationCookiesSentToAgent && !observations.creatorCredentialSentToAgent && !observations.mobileOverflow && !observations.desktopOverflow && observations.keyboardFocusVisible, "Browser acceptance observations failed");
  const status = await control("/verify", {});
  check(status.oneBrowserEffect && status.noRetryModelCall, "Authoritative browser effect proof failed");
