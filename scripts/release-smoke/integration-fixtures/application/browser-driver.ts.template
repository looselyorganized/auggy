import { chromium } from "playwright";
import { createHash } from "node:crypto";
import { constants, openSync, closeSync, fstatSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

function check(value, message) { if (!value) throw new Error(message); }
const configPath = process.env.AUGGY_FIXTURE_BROWSER_CONFIG;
check(configPath, "Browser fixture configuration missing");
const fd = openSync(configPath, constants.O_RDONLY | constants.O_NOFOLLOW);
let config;
try {
  const stat = fstatSync(fd);
  check(stat.isFile() && stat.nlink === 1 && (stat.mode & 0o7777) === 0o600 && stat.size <= 16384, "Browser fixture configuration is not private and bounded");
  config = JSON.parse(readFileSync(fd, "utf8"));
} finally { closeSync(fd); }
for (const value of [config.appOrigin, config.agentOrigin, config.controlOrigin, process.env.AUGGY_FIXTURE_BROWSER_CDP_ENDPOINT]) {
  const url = new URL(value);
  check(url.protocol === "http:" && url.hostname === "127.0.0.1" && url.port && url.pathname === "/" && !url.username && !url.password && !url.search && !url.hash, "Browser fixture requires owned loopback origins");
}
const browser = await chromium.connectOverCDP(process.env.AUGGY_FIXTURE_BROWSER_CDP_ENDPOINT, { timeout: 15000 });
const contexts = [];
const observations = { version: 1, firstChunkBeforeTerminal: false, directAgentRequests: 0, freshAssertionCount: 0, stableRetryKey: false, applicationCookiesSentToAgent: false, creatorCredentialSentToAgent: false, interruptedThenCompleted: false, mobileOverflow: false, desktopOverflow: false, layout: {}, keyboardFocusVisible: false, checks: [] };
const assertions = new Set();
const keys = [];
const pending = [];
let phase = "initial-browser";
async function control(path, body) {
  const response = await fetch(`${config.controlOrigin}${path}`, { method: "POST", headers: { authorization: `Bearer ${config.controlToken}`, "content-type": "application/json" }, body: JSON.stringify(body), redirect: "error", signal: AbortSignal.timeout(10000) });
  check(response.ok, "Private browser control rejected operation");
  return await response.json();
}
async function pageFor(cookie) {
  check(/^[0-9a-f]{64}$/.test(cookie), "Invalid opaque fixture session");
  const context = await browser.newContext({ viewport: { width: 1365, height: 1000 }, reducedMotion: "reduce" });
  contexts.push(context);
  await context.route("**/*", route => {
    const origin = new URL(route.request().url()).origin;
    return [config.appOrigin, config.agentOrigin].includes(origin) ? route.continue() : route.abort("blockedbyclient");
  });
  await context.addCookies([{ name: "auggy_fixture_session", value: cookie, url: config.appOrigin, httpOnly: true, sameSite: "Strict" }]);
