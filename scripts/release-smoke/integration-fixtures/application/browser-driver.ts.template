} catch (error) {
  let message = error instanceof Error ? error.message : "Browser fixture failed";
  for (const secret of [config.controlToken, ...Object.values(config.sessions)]) message = message.split(secret).join("[REDACTED]");
  writeFileSync(join(config.screenshotDirectory, "browser-failure.json"), JSON.stringify({phase,message:message.slice(0,4096)}), {flag:"wx",mode:0o600});
  throw new Error(`Browser fixture failed at ${phase}`);
} finally {
  for (const context of contexts.reverse()) await context.close();
  await browser.close();
}
