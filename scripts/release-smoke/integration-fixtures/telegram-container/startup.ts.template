import { createTelegramProtocolFixture } from "./telegram-protocol";
import { createProviderFixture } from "./telegram-provider";

const PROXY_ORIGIN = "http://127.0.0.1:43141";
const CONTROL_ORIGIN = "http://127.0.0.1:43142";
const QUIESCENT = "auggy-telegram-container-fixtures:quiescent";
let shutdown: (() => Promise<void>) | undefined;

async function readControl(request: Request): Promise<Record<string, unknown>> {
  const reader = request.body?.getReader();
  if (!reader) throw new Error("Missing fixture control body.");
  const chunks: Uint8Array[] = [];
  let bytes = 0;
  let timedOut = false;
  const timer = setTimeout(() => { timedOut = true; void reader.cancel().catch(() => {}); }, 2000);
  try {
    for (;;) {
      const next = await reader.read();
      if (timedOut) throw new Error("Fixture control body timed out.");
      if (next.done) break;
      bytes += next.value.byteLength;
      if (bytes > 4096) throw new Error("Fixture control body exceeded bound.");
      chunks.push(next.value);
    }
    const value: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
    if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("Invalid fixture control body.");
    return value as Record<string, unknown>;
  } finally {
    clearTimeout(timer);
    void reader.cancel().catch(() => {});
  }
}

/** Explicit fixture startup, evaluated before installing the reviewed fetch adapter. */
export async function startContainerTelegramFixture() {
  if (shutdown) throw new Error("Container fixtures already started.");
  const token = process.env.AUGGY_FIXTURE_CONTROL_TOKEN;
  if (!token || !/^[a-f0-9]{64}$/.test(token)) throw new Error("Missing private fixture control authority.");
  if (process.env.AUGGY_FIXTURE_TELEGRAM_ORIGIN !== PROXY_ORIGIN || process.env.AUGGY_FIXTURE_MODEL_ORIGIN !== PROXY_ORIGIN)
    throw new Error("Fixture origins do not match the recorded loopback proxy.");
  const nativeFetch = globalThis.fetch;
  const telegram = createTelegramProtocolFixture();
  let model: ReturnType<typeof createProviderFixture> | undefined;
  let proxy: ReturnType<typeof Bun.serve> | undefined;
  let control: ReturnType<typeof Bun.serve> | undefined;
  let activeProxy = 0;
  let activeControl = 0;
  let controlCalls = 0;
  let closing = false;
  const stop = async () => {
    if (closing) return;
    closing = true;
    const results = await Promise.allSettled([
      control?.stop(true), proxy?.stop(true), model?.stop(), telegram.stop(),
    ]);
    if (results.some((result) => result.status === "rejected") || activeProxy !== 0 || activeControl !== 0)
      throw new Error("Container fixture shutdown did not quiesce.");
  };
  try {
    model = createProviderFixture({
      toolResultSentinel: "telegram-proof:",
      tool: { name: "telegram_proof_effect", input: { operation: "probe" }, invalidInput: { operation: 7 } },
      maxCalls: 4,
      maxRequestBytes: 256 * 1024,
    });
    const provider = model;
    proxy = Bun.serve({
      hostname: "127.0.0.1", port: 43141, idleTimeout: 5, maxRequestBodySize: 256 * 1024,
      async fetch(request) {
        const url = new URL(request.url);
        const protocolPath = ["/telegram/getUpdates", "/telegram/sendMessage", "/telegram/getChat", "/telegram/deleteWebhook", "/telegram/setWebhook", "/attempt", "/effect"].includes(url.pathname);
        if (closing || activeProxy >= 8 || request.method !== "POST" || url.search ||
          (!protocolPath && url.pathname !== "/v1/messages")) return new Response(null, { status: 404 });
        activeProxy++;
        try {
          const destination = `${protocolPath ? telegram.origin : provider.baseURL}${url.pathname}`;
          return await nativeFetch.call(globalThis, new Request(destination, request), {
            redirect: "manual", signal: AbortSignal.any([request.signal, AbortSignal.timeout(10000)]),
          });
        } catch { return new Response(null, { status: 502 }); }
        finally { activeProxy--; }
      },
    });
    control = Bun.serve({
      hostname: "127.0.0.1", port: 43142, idleTimeout: 5, maxRequestBodySize: 4096,
      async fetch(request) {
        if (closing || activeControl >= 2 || ++controlCalls > 128) return new Response(null, { status: 503 });
        if (request.method !== "POST" || request.url !== `${CONTROL_ORIGIN}/control` ||
          request.headers.get("x-fixture-control") !== token) return new Response(null, { status: 403 });
        activeControl++;
        try {
          const input = await readControl(request);
          if (input.operation === "enqueue" && Object.keys(input).length === 2) {
            const update = input.update as { update_id?: unknown; message?: { text?: unknown; chat?: { id?: unknown; type?: unknown }; from?: { id?: unknown } } } | undefined;
            if (!update || !Number.isSafeInteger(update.update_id) || !update.message ||
              typeof update.message.text !== "string" || update.message.text.length > 256 ||
              !Number.isSafeInteger(update.message.from?.id) || !Number.isSafeInteger(update.message.chat?.id) ||
              !["private", "group"].includes(String(update.message.chat?.type))) throw new Error("Invalid fixture update.");
            provider.reset();
            telegram.enqueue(input.update as Parameters<typeof telegram.enqueue>[0]);
          } else if (input.operation !== "snapshot" || Object.keys(input).length !== 1) {
            throw new Error("Unknown fixture control operation.");
          }
          const output = JSON.stringify({ version: 1, protocol: telegram.snapshot(), provider: provider.evidence() });
          if (Buffer.byteLength(output) > 2 * 1024 * 1024) throw new Error("Fixture snapshot exceeded bound.");
          return new Response(output, { headers: { "content-type": "application/json" } });
        } catch { return Response.json({ error: "fixture-control-rejected" }, { status: 400 }); }
        finally { activeControl--; }
      },
    });
    shutdown = stop;
    return { telegramOrigin: PROXY_ORIGIN, modelOrigin: PROXY_ORIGIN };
  } catch {
    await stop();
    throw new Error("Container fixture startup failed.");
  }
}

/** Existing augment shutdown contract; no production runtime lifecycle hook is added. */
export async function stopContainerTelegramFixture(): Promise<void> {
  await shutdown?.();
  console.log(QUIESCENT);
}
