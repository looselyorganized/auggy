# Copy to .env.dx.local and fill only what you want the DX lab agent to use.
# .env.dx.local is gitignored.

# Required for real Anthropic chat.
ANTHROPIC_API_KEY=

# Optional: the exact AgentMail key Auggy should use at runtime, plus the
# existing inbox that key is allowed to access. The DX lab never creates an
# inbox or another API key.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Optional: notify creator over Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: also install telegramTransport for inbound Telegram chat.
TELEGRAM_CREATOR_USER_IDS=
