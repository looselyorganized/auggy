# Copy to .env.dx.local and fill only what you want the DX lab agent to use.
# .env.dx.local is gitignored.

# Required for real Anthropic chat.
ANTHROPIC_API_KEY=

# Optional: existing AgentMail runtime credentials for visitorAuth magic links.
# Use this pair when you already have an inbox.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Optional: parent AgentMail key. The lab script can create a fresh inbox with it.
# This key is read by the script but is not copied into the generated agent .env.
AGENTMAIL_PARENT_API_KEY=

# Optional: notify creator over Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: also install telegramTransport for inbound Telegram chat.
TELEGRAM_CREATOR_USER_IDS=
