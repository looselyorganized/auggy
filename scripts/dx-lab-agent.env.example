# Copy to .env.dx.local and fill only what you want the DX lab agent to use.
# .env.dx.local is gitignored.

# Required for real Anthropic chat.
ANTHROPIC_API_KEY=

# Optional: the exact AgentMail key Auggy should use for visitorAuth magic links.
# With an inbox ID, the lab connects that inbox. Without one, it creates an inbox
# using this same key and keeps using this same key at runtime.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Optional: notify creator over Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: also install telegramTransport for inbound Telegram chat.
TELEGRAM_CREATOR_USER_IDS=
