{
  "name": "auggy",
  "version": "0.4.4",
  "description": "Modular agent runtime — composable augments, multi-engine, SQLite-first memory.",
  "keywords": [
    "agent",
    "agents",
    "ai",
    "anthropic",
    "claude",
    "openai",
    "openrouter",
    "llm",
    "runtime",
    "framework",
    "bun",
    "typescript",
    "memory",
    "sqlite",
    "a2a",
    "ag-ui"
  ],
  "license": "Apache-2.0",
  "author": "LORF (Loosely Organized Research Facility)",
  "homepage": "https://github.com/looselyorganized/augment-1#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/looselyorganized/augment-1.git"
  },
  "bugs": {
    "url": "https://github.com/looselyorganized/augment-1/issues"
  },
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/index.ts",
    "./internal/cost": "./src/engines/_shared/cost.ts",
    "./internal/schema-normalize": "./src/engines/_shared/schema-normalize.ts",
    "./internal/tool-call": "./src/engines/_shared/tool-call.ts",
    "./internal/prompt-assembly": "./src/engines/_shared/prompt-assembly.ts",
    "./internal/anthropic-pricing": "./src/engines/anthropic/pricing.ts",
    "./internal/openai-pricing": "./src/engines/openai/pricing.ts",
    "./internal/openrouter-pricing": "./src/engines/openrouter/pricing.ts",
    "./internal/agent": "./src/agent.ts",
    "./internal/helpers": "./src/helpers.ts",
    "./internal/types": "./src/types.ts",
    "./internal/cli/config-parser": "./src/cli/config-parser.ts",
    "./internal/cli/engine-resolver": "./src/cli/engine-resolver.ts",
    "./internal/cli/augment-resolver": "./src/cli/augment-resolver.ts",
    "./internal/augments/layered-memory": "./src/augments/layered-memory/index.ts",
    "./internal/augments/layered-memory/storage/types": "./src/augments/layered-memory/storage/types.ts",
    "./internal/augments/layered-memory/storage/sqlite-store": "./src/augments/layered-memory/storage/sqlite-store.ts",
    "./internal/augments/layered-memory/extractor/inject-handler": "./src/augments/layered-memory/extractor/inject-handler.ts",
    "./internal/augments/layered-memory/extractor/frequency": "./src/augments/layered-memory/extractor/frequency.ts"
  },
  "bin": {
    "auggy": "src/cli/index.ts"
  },
  "files": [
    "src",
    "admin/dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "private": false,
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx --bun @biomejs/biome check",
    "lint:fix": "bunx --bun @biomejs/biome check --write",
    "format": "bunx --bun @biomejs/biome format --write"
  },
  "devDependencies": {
    "@auggy/link": "^0.1.2",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@supabase/supabase-js": "^2.103.0",
    "commander": "^14.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
