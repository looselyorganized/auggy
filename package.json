{
  "name": "auggy",
  "version": "0.5.0-rc.5",
  "description": "Turn business operations into agent-ready capabilities with controlled, predictable TypeScript augments.",
  "keywords": [
    "agent",
    "agents",
    "ai",
    "anthropic",
    "claude",
    "openai",
    "openrouter",
    "llm",
    "runtime",
    "framework",
    "self-hosted",
    "composable",
    "augments",
    "tools",
    "skills",
    "transports",
    "bun",
    "typescript",
    "memory",
    "sqlite",
    "a2a",
    "ag-ui",
    "mcp"
  ],
  "license": "Apache-2.0",
  "author": "LORF (Loosely Organized Research Facility)",
  "homepage": "https://auggy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looselyorganized/auggy.git"
  },
  "bugs": {
    "email": "hello@looselyorganized.xyz"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./internal/cost": "./src/engines/_shared/cost.ts",
    "./internal/schema-normalize": "./src/engines/_shared/schema-normalize.ts",
    "./internal/tool-call": "./src/engines/_shared/tool-call.ts",
    "./internal/prompt-assembly": "./src/engines/_shared/prompt-assembly.ts",
    "./internal/response-limits": "./src/engines/_shared/response-limits.ts",
    "./internal/credential-transport": "./src/engines/_shared/credential-transport.ts",
    "./internal/provider-error": "./src/engines/_shared/provider-error.ts",
    "./internal/provider-resilience": "./src/engines/_shared/provider-resilience.ts",
    "./internal/anthropic-pricing": "./src/engines/anthropic/pricing.ts",
    "./internal/openai-pricing": "./src/engines/openai/pricing.ts",
    "./internal/openrouter-pricing": "./src/engines/openrouter/pricing.ts",
    "./internal/agent": "./src/agent.ts",
    "./internal/helpers": "./src/helpers.ts",
    "./internal/types": "./src/types.ts",
    "./internal/cli/config-parser": "./src/cli/config-parser.ts",
    "./internal/cli/engine-resolver": "./src/cli/engine-resolver.ts",
    "./internal/cli/augment-resolver": "./src/cli/augment-resolver.ts",
    "./internal/cli/types": "./src/cli/types.ts",
    "./internal/augments/layeredMemory": "./src/augments/layeredMemory/index.ts",
    "./internal/augments/layeredMemory/storage/types": "./src/augments/layeredMemory/storage/types.ts",
    "./internal/augments/layeredMemory/storage/sqlite-store": "./src/augments/layeredMemory/storage/sqlite-store.ts",
    "./internal/augments/layeredMemory/extractor/inject-handler": "./src/augments/layeredMemory/extractor/inject-handler.ts",
    "./internal/augments/layeredMemory/extractor/frequency": "./src/augments/layeredMemory/extractor/frequency.ts"
  },
  "bin": {
    "auggy": "src/cli/index.ts"
  },
  "files": [
    "src",
    "admin/dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "admin",
    "packages/*"
  ],
  "private": false,
  "scripts": {
    "test": "bun run test:runtime && bun run test:admin",
    "test:full": "bun run test && bun run test:temporal-example",
    "test:inventory": "bun scripts/test-surface-inventory.ts check",
    "test:runtime": "bun scripts/test-surface-inventory.ts run-runtime",
    "test:admin": "bun scripts/test-surface-inventory.ts run console",
    "test:temporal-example": "bash scripts/test-temporal-example.sh",
    "test:watch": "bun test --watch ./tests ./examples ./packages",
    "dx:agent": "bash scripts/dx-lab-agent.sh",
    "smoke:release": "bash scripts/release-smoke.sh",
    "build:admin": "bun run --cwd admin build",
    "verify:admin": "bun run --cwd admin verify:build",
    "prepack": "bun scripts/prepack.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun @biomejs/biome@2.5.5 check",
    "lint:fix": "bunx --bun @biomejs/biome@2.5.5 check --write",
    "format": "bunx --bun @biomejs/biome@2.5.5 format --write"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@auggy/anthropic": "workspace:*",
    "@auggy/link": "^0.1.2",
    "@auggy/ollama": "workspace:*",
    "@auggy/openai": "workspace:*",
    "@auggy/openrouter": "workspace:*",
    "@hono/node-server": "2.0.11",
    "@inquirer/core": "^10.3.2",
    "@types/bun": "latest",
    "ollama": "^0.6.0",
    "openai": "^6.34.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "postcss": "8.5.25",
    "undici": "7.29.0"
  },
  "dependencies": {
    "@inquirer/prompts": "7.8.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.103.0",
    "agentmail": "0.5.14",
    "commander": "^14.0.3",
    "svix": "1.96.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
