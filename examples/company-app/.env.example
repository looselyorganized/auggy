# Runtime configuration: the frontend does not bake in the agent hostname.
APP_ORIGIN=http://localhost:3000
AUGGY_AGENT_URL=http://localhost:8080

# Supply independent server-only signing material for this company's deployment.
# The audience/key ID must match agent.yaml. Never prefix these with NEXT_PUBLIC_.
AUGGY_AUTH_AUDIENCE=company-support-agent
AUGGY_AUTH_KEY_ID=company-key-v1
AUGGY_AUTH_SECRET=

# Your company-owned permission/order service. The synthetic fixture implements
# the same narrow protocol for local acceptance; it is not a production backend.
ORDERS_SERVICE_URL=http://127.0.0.1:8090
ORDERS_SERVICE_TOKEN=

# This does not enable authentication. Implement src/server/session-adapter.ts
# using your existing trusted session verifier before the app can issue assertions.
