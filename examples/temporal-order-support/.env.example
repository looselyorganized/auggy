# Temporal deployment configuration. These values are read by the worker and
# starter, never by the Workflow or from a model request.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=auggy-order-support

# The Auggy service identity is worker-only configuration. Use an HTTPS origin
# in deployed environments; localhost HTTP is intentionally rejected here.
AUGGY_TARGET=https://auggy.example.com
AUGGY_BEARER_TOKEN=replace-with-an-operator-managed-secret

# Bounds for one HTTP/SSE Activity attempt. The client also enforces immutable
# ceilings of 4 MiB and 100,000 events. Keep these below the Temporal Activity
# start-to-close timeout configured in src/workflow-policy.ts.
AUGGY_MAX_SSE_BYTES=1048576
AUGGY_MAX_SSE_EVENTS=10000
